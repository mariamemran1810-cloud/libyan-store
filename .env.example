# ===== إعدادات التطبيق =====
APP_NAME="المتجر الليبي"
APP_ENV=local
# true للتطوير فقط - اجعله false عند النشر
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tripoli
APP_LOCALE=ar
APP_CURRENCY=LYD
APP_CURRENCY_SYMBOL="د.ل"
APP_CURRENCY_DECIMALS=3

# مفتاح تشفير عشوائي - ولّديه بهذا الأمر ثم ضعيه هنا:
# php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ===== قاعدة البيانات =====
DB_DRIVER=sqlite
DB_DATABASE=database/database.sqlite
# عند استخدام MySQL قم/ي بإزالة علامة # من البنود التالية:
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=libyan_store
# DB_USER=root
# DB_PASSWORD=

# ===== الجلسة =====
SESSION_NAME=libyan_store_session

# ===== رفع الملفات =====
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_MB=2